# Secrets — never copy into the image
.env
.env.*
!.env.example

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Test and analysis artifacts
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# Virtual environments
.venv/
venv/
env/

# Build artifacts
*.egg-info/
dist/
build/

# Version control
.git/
.gitignore

# Spec and history directories (not needed at runtime)
specs/
history/

# Editor / OS artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/

# Docker files (not needed inside the container)
Dockerfile*
.dockerignore
