# =============================================================================
# DevSphere ERP — Environment Variables
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL Database (used by the db Docker service)
# -----------------------------------------------------------------------------

# PostgreSQL database name
POSTGRES_DB=devsphere_dev

# PostgreSQL username
POSTGRES_USER=devsphere

# PostgreSQL password — change this to a strong password
POSTGRES_PASSWORD=changeme_dev_password

# -----------------------------------------------------------------------------
# Backend — Required
# -----------------------------------------------------------------------------

# Full PostgreSQL connection URL for SQLAlchemy
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
# In Docker Compose, host is the service name: db
DATABASE_URL=postgresql://devsphere:changeme_dev_password@db:5432/devsphere_dev

# Application secret key — generate with: openssl rand -hex 32
# MUST be at least 32 characters. NEVER use this example value in production.
SECRET_KEY=change-this-to-a-long-random-secret

# Runtime environment — one of: development, testing, production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Backend — Optional (defaults shown)
# -----------------------------------------------------------------------------

# Enable debug mode (true/false)
# In debug mode: Swagger UI (/docs), ReDoc (/redoc), and verbose errors are enabled
# MUST be false in production
DEBUG=true

# Comma-separated list of allowed CORS origins
# Example: http://localhost:3000,https://app.example.com
# In development, defaults to allow all origins if not set
CORS_ORIGINS=["http://localhost:3000"]

# Minimum log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# API version string returned in health check responses
API_VERSION=1.0.0

# SQLAlchemy connection pool size (number of persistent connections)
DB_POOL_SIZE=5

# Maximum number of connections to overflow beyond DB_POOL_SIZE
DB_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# Authentication — JWT (Epic 002)
# -----------------------------------------------------------------------------

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# MUST be at least 32 characters. NEVER use this placeholder in production. NEVER commit the real value.
JWT_SECRET_KEY=change-this-to-another-long-random-secret

# JWT signing algorithm (HS256 for single-server; RS256 for multi-service)
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 15 minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Standard refresh token lifetime in days, no Remember Me (default: 7 days)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Extended refresh token lifetime in days when Remember Me is selected (default: 30 days)
JWT_REMEMBER_ME_EXPIRE_DAYS=30

# JWT issuer claim — must match across all services validating tokens
JWT_ISSUER=devsphere-erp

# JWT audience claim — identifies the intended recipient
JWT_AUDIENCE=devsphere-erp-api

# Clock skew tolerance in seconds during JWT validation (default: 30 seconds)
JWT_CLOCK_SKEW_SECONDS=30

# -----------------------------------------------------------------------------
# Authentication — Argon2id Password Hashing (Epic 002)
# -----------------------------------------------------------------------------

# Argon2 time cost (iterations). Higher = slower = more secure. Default: 3
ARGON2_TIME_COST=3

# Argon2 memory cost in kibibytes. OWASP minimum: 19456 (19 MiB). Default: 65536 (64 MiB)
ARGON2_MEMORY_COST=65536

# Argon2 parallelism (threads). Typically set to number of available CPU cores. Default: 4
ARGON2_PARALLELISM=4

# -----------------------------------------------------------------------------
# Authentication — Account Lockout Policy (Epic 002)
# -----------------------------------------------------------------------------

# Number of consecutive failed login attempts before account is locked (default: 5)
AUTH_LOCKOUT_THRESHOLD=5

# Sliding window in minutes over which failed attempts are counted (default: 15)
AUTH_LOCKOUT_WINDOW_MINUTES=15

# Duration in minutes that a locked account stays locked before auto-unlock (default: 30)
AUTH_LOCKOUT_DURATION_MINUTES=30

# -----------------------------------------------------------------------------
# Authentication — Password Policy (Epic 002)
# -----------------------------------------------------------------------------

# Minimum password length in characters (default: 12; NIST recommends >= 8)
PASSWORD_MIN_LENGTH=12

# Maximum password length in characters (default: 128; prevents DoS via huge inputs)
PASSWORD_MAX_LENGTH=128

# Number of previous password hashes retained to prevent reuse (default: 5; range: 1-24)
PASSWORD_HISTORY_COUNT=5

# -----------------------------------------------------------------------------
# Authentication — Audit Log (Epic 002)
# -----------------------------------------------------------------------------

# Minimum audit log retention period in days (default: 90; SOC2/ISO 27001 compliance)
AUDIT_LOG_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Storage — Object Storage / S3-compatible (Epic 003)
# -----------------------------------------------------------------------------

# Storage backend to use: s3 | local (default: s3 — uses MinIO in development)
STORAGE_BACKEND=s3

# S3/MinIO endpoint URL — in Docker Compose development: http://minio:9000
# For AWS S3: leave unset or set to https://s3.amazonaws.com
S3_ENDPOINT=http://minio:9000

# S3 bucket name for company assets (logos, documents)
S3_BUCKET=devsphere-companies

# S3/MinIO access key — matches MINIO_ROOT_USER for local development
S3_ACCESS_KEY=minioadmin

# S3/MinIO secret key — matches MINIO_ROOT_PASSWORD for local development
# NEVER use this example value in production
S3_SECRET_KEY=minioadmin

# AWS region — use us-east-1 for MinIO (ignored by MinIO but required by boto3)
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Companies — Business Rules (Epic 003)
# -----------------------------------------------------------------------------

# Maximum number of companies a single owner can create (0 = unlimited)
COMPANY_LIMIT=10

# Maximum allowed size for a company logo file in bytes (default: 2 MiB)
COMPANY_LOGO_MAX_BYTES=2097152

# Number of days soft-deleted companies are retained before permanent deletion
COMPANY_DELETION_RETENTION_DAYS=30

# Number of days a replaced logo is retained in storage before being purged
LOGO_RETENTION_DAYS=7

# -----------------------------------------------------------------------------
# Frontend — Required
# -----------------------------------------------------------------------------

# Backend API base URL — accessed from the browser
# In Docker Compose development: http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Frontend — Optional (defaults shown)
# -----------------------------------------------------------------------------

# Application display name shown in the UI
NEXT_PUBLIC_APP_NAME=DevSphere ERP

# Frontend environment identifier (for analytics/monitoring)
NEXT_PUBLIC_ENVIRONMENT=development
